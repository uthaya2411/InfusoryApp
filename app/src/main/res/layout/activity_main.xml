<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <!-- Canvas area for 3D model containers -->
    <FrameLayout
        android:id="@+id/canvasRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Floating Header Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/overlay_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3D Model Viewer"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFpsCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS: --"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvModelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Models: 0"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_mode_badge_normal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Action Button for Adding Models -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddModel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="Add Model"
        android:textColor="@color/text_white"
        app:icon="@drawable/ic_rotate"
        app:iconTint="@color/text_white"
        app:backgroundTint="@color/primary"
        app:elevation="8dp" />

</FrameLayout>
